# ==============================================================================
# PRAETORIAN TECHNOLOGY — EMAIL & SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (Local)
PORT=3000

# Gmail SMTP Configuration
# Note: SMTP_PASSWORD MUST be a 16-character Google App Password (not your normal password).
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=teenideas.in@gmail.com
SMTP_PASSWORD=YOUR_16_CHAR_GOOGLE_APP_PASSWORD
EMAIL_TO=teenideas.in@gmail.com

# Optional Customer Acknowledgement Email (true/false)
SEND_ACKNOWLEDGEMENT=true
